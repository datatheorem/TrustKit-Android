<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- This XML file is needed for running the unit tests on Android N+ -->
    <domain-config>
        <!-- testPinnedDomainSuccessAnchor() -->
        <domain>www.datatheorem.com</domain>
        <pin-set>
            <!-- CA key for Google Trust Services (cert valid until 27 Jan 2028), as in the iOS tests -->
            <pin digest="SHA-256">hxqRlPTu1bMS/0DITB1SSu0vd4u/8l8TjPgfaAp63Gc=</pin>
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
        </pin-set>
        <trustkit-config enforcePinning="true">
        </trustkit-config>
    </domain-config>
    <domain-config>
        <!-- testPinnedDomainSuccessIntermediate() -->
        <domain>datatheorem.com</domain>
        <pin-set>
            <!-- Intermediate CA key for Google Trust Services WR3, as in the iOS tests -->
            <pin digest="SHA-256">OdSlmQD9NWJh4EbcOHBxkhygPwNSwA9Q91eounfbcoE=</pin>
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
        </pin-set>
        <trustkit-config enforcePinning="true">
        </trustkit-config>
    </domain-config>
    <domain-config>
        <!-- testPinnedDomainInvalidPin() -->
        <domain>www.yahoo.com</domain>
        <pin-set>
            <!-- Invalid pins -->
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
            <pin digest="SHA-256">BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=</pin>
        </pin-set>
        <trustkit-config enforcePinning="true">
        </trustkit-config>
    </domain-config>
    <domain-config>
        <!-- testPinnedDomainInvalidPinAndPinningNotEnforced() -->
        <domain>www.facebook.com</domain>
        <pin-set>
            <!-- Invalid pins -->
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
            <pin digest="SHA-256">BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=</pin>
        </pin-set>
        <trustkit-config enforcePinning="false">
        </trustkit-config>
    </domain-config>
    <domain-config>
        <!-- testPinnedDomainInvalidPinAndPolicyExpired() -->
        <domain>www.microsoft.com</domain>
        <pin-set expiration="2015-01-01">
            <!-- Invalid pins -->
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
            <pin digest="SHA-256">BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=</pin>
        </pin-set>
        <trustkit-config enforcePinning="false">
        </trustkit-config>
    </domain-config>
    <domain-config>
        <!-- testPinnedDomainExpiredChain() -->
        <domain>expired.badssl.com</domain>
        <pin-set>
            <!-- Invalid pins -->
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
            <pin digest="SHA-256">BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=</pin>
        </pin-set>
        <trustkit-config enforcePinning="false">
        </trustkit-config>
    </domain-config>
    <domain-config>
        <!-- testPinnedDomainUntrustedChainAndPinningNotEnforced() -->
        <domain>self-signed.badssl.com</domain>
        <pin-set>
            <!-- Leaf key, as in the iOS tests: a matching pin must not make an untrusted chain pass -->
            <pin digest="SHA-256">9SLklscvzMYj8f+52lp5ze/hY0CFHyLSPQzSpYYIBm8=</pin>
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
        </pin-set>
        <trustkit-config enforcePinning="false">
        </trustkit-config>
    </domain-config>
    <domain-config>
        <!-- testPinnedDomainWrongHostnameChain() -->
        <domain>wrong.host.badssl.com</domain>
        <pin-set>
            <!-- Invalid pins -->
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
            <pin digest="SHA-256">BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=</pin>
        </pin-set>
        <trustkit-config enforcePinning="false">
        </trustkit-config>
    </domain-config>
</network-security-config>